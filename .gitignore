# Cursor (helyi agent / chat cache — nem verziózandó)
.cursor/

# --- web (Vite / npm / Svelte → html/web build) ---
web/node_modules/
web/dist/
web/.vite/
web/.svelte-kit/
web/coverage/
web/*.log
web/npm-debug.log*
web/.env
web/.env.*
!web/.env.example

# --- általános (OS, IDE, naplók) ---
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
*.temp
*.bak
*.swp
*~

# VSCode (csak a gyökérben; web/.vscode a web/.gitignore szerint)
.vscode/*
!.vscode/extensions.json
.idea/

# Python (ha futtatod a repo scriptjeit lokálisan)
__pycache__/
*.py[cod]
.venv/
venv/
