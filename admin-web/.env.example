VITE_USE_MOCK_DIAGNOSTICS=false
VITE_USE_MOCK_REGISTRY=false

# e_core HTTP admin bridge base URL (example for local FXServer)
VITE_ADMIN_API_BASE_URL=http://127.0.0.1:30120

# Auth headers for /admin/professions and /admin/level-profiles
# Use either identifier OR token (or both), per server config.
VITE_ADMIN_IDENTIFIER_HEADER=x-ecore-identifier
VITE_ADMIN_IDENTIFIER=fivem:12345678

VITE_ADMIN_TOKEN_HEADER=x-ecore-token
VITE_ADMIN_TOKEN=change-me
